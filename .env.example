# Clave API de Resend (obtenida en resend.com)
RESEND_API_KEY=re_...

# Correo remitente desde tu dominio verificado
RESEND_FROM_EMAIL=Solución Créditicia <informacion@solucioncrediticia.org>

# Correos destinatarios (puedes poner varios separados por coma)
RESEND_TO_EMAIL=informacion@solucioncrediticia.org, gerencia@solucioncrediticia.org
